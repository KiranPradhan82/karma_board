# TeamForge PM - Environment Variables
# Copy this file to .env and fill in your values

# Database (Turso SQLite)
DATABASE_URL="file:./db/custom.db"
TURSO_DATABASE_URL="libsql://your-db-name.your-region.turso.io?authToken=YOUR_TOKEN"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Authentication (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# GitHub (for GLM agent mode)
GITHUB_TOKEN="ghp_your-github-pat"

# Email Configuration
# Provider: "gmail-smtp" (default, for testing) or "resend" (for production with domain)
EMAIL_PROVIDER="gmail-smtp"

# Gmail SMTP (for testing without a domain)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an app password (16 characters)
# 3. Set SMTP_USER = your Gmail address
# 4. Set SMTP_PASSWORD = the 16-char app password (with NO spaces)
SMTP_USER="yourname@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# From name shown in emails (used by both Gmail SMTP and Resend)
EMAIL_FROM_NAME="KarmaBoard"

# Resend (switch to this when you have a domain)
# To switch: set EMAIL_PROVIDER="resend" and add RESEND_API_KEY + RESEND_FROM_EMAIL
# RESEND_API_KEY="re_your-resend-key"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

# SMS (Twilio - optional)
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1..."

# AI / Karma Space (Multi-Provider Support)
# Supports OpenAI, Groq, Google Gemini, Together AI — configure one or more providers.
# The system auto-routes each model to its correct provider based on the model ID.

# === Generic fallback (works with any single provider) ===
# AI_API_KEY="sk-your-api-key-here"
# AI_API_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="llama-3.3-70b-versatile"  # Global default model
# AI_VISION_MODEL=""  # Optional: separate model for image analysis

# === Groq (FREE tier available — low TPM limits) ===
# GROQ_API_KEY="gsk_your-groq-key"
# GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it

# === OpenAI (paid — highest quality, high TPM) ===
# OPENAI_API_KEY="sk-your-openai-key"
# OPENAI_API_BASE_URL="https://api.openai.com/v1"
# Models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo

# === Google Gemini (FREE — 1M context, best for large prompts like /docs) ===
# Get API key from https://aistudio.google.com/apikey (free, no credit card)
# GOOGLE_AI_API_KEY="AIzaSy-your-google-key"
# GOOGLE_AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# Models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro (all FREE)

# === Together AI (free tier available) ===
# TOGETHER_API_KEY="your-together-key"
# TOGETHER_API_BASE_URL="https://api.together.xyz/v1"
# Models: meta-llama/Llama-3-70b-chat-hf, mistralai/Mixtral-8x7B-Instruct-v0.1

# === Zhipu AI / Z.ai — GLM (FREE, 200K context, generous rate limits) ===
# Sign up at https://z.ai/chat (email or Google, no credit card) — get 20M free tokens
# API key page: https://z.ai/manage-apikey/apikey-list
# ZAI_API_KEY="your-zai-key"
# ZAI_API_BASE_URL="https://api.z.ai/api/paas/v4"
# Models: glm-4-plus (best quality), glm-4-flash (fastest), glm-4-air (balanced)

# === SambaNova (FREE, 100+ RPM — best for heavy usage like /docs) ===
# Sign up at https://cloud.sambanova.ai (free, no credit card)
# SAMBANOVA_API_KEY="your-sambanova-key"
# Models: DeepSeek-V3.1, Meta-Llama-3.3-70B-Instruct, Llama-4-Maverick-17B-128E-Instruct

# Deployment (Vercel - optional, for GLM agent mode)
# VERCEL_TOKEN="your-vercel-token"
# VERCEL_PROJECT_ID="your-vercel-project-id"

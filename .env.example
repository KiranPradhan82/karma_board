# TeamForge PM - Environment Variables
# Copy this file to .env and fill in your values

# Database (Turso SQLite)
DATABASE_URL="file:./db/custom.db"
TURSO_DATABASE_URL="libsql://your-db-name.your-region.turso.io?authToken=YOUR_TOKEN"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Authentication (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# GitHub (for GLM agent mode)
GITHUB_TOKEN="ghp_your-github-pat"

# Email (Resend - optional)
# RESEND_API_KEY="re_your-resend-key"

# SMS (Twilio - optional)
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1..."

# Deployment (Vercel - optional, for GLM agent mode)
# VERCEL_TOKEN="your-vercel-token"
# VERCEL_PROJECT_ID="your-vercel-project-id"

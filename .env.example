# TeamForge PM - Environment Variables
# Copy this file to .env and fill in your values

# Database (Turso SQLite)
DATABASE_URL="file:./db/custom.db"
TURSO_DATABASE_URL="libsql://your-db-name.your-region.turso.io?authToken=YOUR_TOKEN"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Authentication (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# GitHub (for GLM agent mode)
GITHUB_TOKEN="ghp_your-github-pat"

# Email Configuration
# Provider: "gmail-smtp" (default, for testing) or "resend" (for production with domain)
EMAIL_PROVIDER="gmail-smtp"

# Gmail SMTP (for testing without a domain)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an app password (16 characters)
# 3. Set SMTP_USER = your Gmail address
# 4. Set SMTP_PASSWORD = the 16-char app password (with NO spaces)
SMTP_USER="yourname@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# From name shown in emails (used by both Gmail SMTP and Resend)
EMAIL_FROM_NAME="KarmaBoard"

# Resend (switch to this when you have a domain)
# To switch: set EMAIL_PROVIDER="resend" and add RESEND_API_KEY + RESEND_FROM_EMAIL
# RESEND_API_KEY="re_your-resend-key"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

# SMS (Twilio - optional)
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1..."

# AI / Karma Space (Required for Karma Space AI chat)
# Supports any OpenAI-compatible API (OpenAI, z-ai, Together, Groq, etc.)
AI_API_KEY="sk-your-api-key-here"
# AI_API_BASE_URL="https://api.openai.com/v1"  # Default: OpenAI. For z-ai: https://internal-api.z.ai/v1
# AI_MODEL="gpt-4o-mini"  # Default model. Use glm-4-flash for z-ai
# AI_VISION_MODEL=""  # Optional: separate model for image analysis

# Deployment (Vercel - optional, for GLM agent mode)
# VERCEL_TOKEN="your-vercel-token"
# VERCEL_PROJECT_ID="your-vercel-project-id"

# ============================================
# TeamForge PM — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# -------------------------------------------
# Database (Turso SQLite)
# -------------------------------------------
# Local development uses file-based SQLite
DATABASE_URL="file:./dev.db"

# Production: Turso cloud database
# Get these from: https://turso.tech
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# -------------------------------------------
# Authentication (NextAuth.js v5)
# -------------------------------------------
# The base URL of your application
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing JWT tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"

# -------------------------------------------
# Email Notifications (Resend)
# -------------------------------------------
# Get from: https://resend.com
RESEND_API_KEY="re_your-api-key-here"

# Sender email (must be verified in Resend)
EMAIL_FROM="TeamForge PM <noreply@yourdomain.com>"

# -------------------------------------------
# SMS Notifications (Twilio) — OPTIONAL
# -------------------------------------------
# Get from: https://www.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# -------------------------------------------
# AI Integration (GLM via z-ai-web-dev-sdk)
# -------------------------------------------
# Built-in SDK — no API key needed for basic usage
# The z-ai-web-dev-sdk is pre-configured in the environment

# -------------------------------------------
# GitHub Integration — FOR AGENT MODE (Future)
# -------------------------------------------
# Personal Access Token with repo access
GITHUB_TOKEN="ghp_your-github-token-here"
GITHUB_REPO="your-username/teamforge-pm"

# -------------------------------------------
# Vercel Deployment — FOR AGENT MODE (Future)
# -------------------------------------------
VERCEL_TOKEN="your-vercel-api-token"
VERCEL_PROJECT_ID="your-vercel-project-id"

# -------------------------------------------
# Optional: Rate Limiting (Upstash Redis)
# -------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# -------------------------------------------
# Optional: Error Tracking (Sentry)
# -------------------------------------------
SENTRY_DSN="your-sentry-dsn"

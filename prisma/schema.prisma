generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id        String   @id
  userId    String
  action    String
  details   String?
  timestamp DateTime @default(now())
  entity    String?
  entityId  String?
  ipAddress String?
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiChat {
  id        String   @id
  userId    String
  projectId String?
  role      String
  content   String
  timestamp DateTime @default(now())
  Project   Project? @relation(fields: [projectId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiProtocol {
  id             String           @id
  name           String
  description    String?
  isGlobal       Boolean          @default(false)
  projectId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  AiProtocolStep AiProtocolStep[]
}

model AiProtocolStep {
  id          String     @id
  protocolId  String
  title       String
  description String?
  commandTag  String?
  stepOrder   Int
  createdAt   DateTime   @default(now())
  AiProtocol  AiProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId])
}

model ChatDeleteRequest {
  id         String    @id
  projectId  String
  userId     String
  status     String    @default("PENDING")
  reason     String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Client {
  id                 String               @id
  name               String
  email              String               @unique
  password           String
  company            String?
  address            String?
  phone              String?
  notes              String?
  status             String               @default("ACTIVE")
  mustChangePassword Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  ClientNotification ClientNotification[]
  Project            Project[]
}

model ClientNotification {
  id        String   @id
  clientId  String
  projectId String
  type      String
  message   String?
  sentBy    String
  createdAt DateTime @default(now())
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String   @id
  email     String
  projectId String?
  role      String   @default("MEMBER")
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
  Project   Project? @relation(fields: [projectId], references: [id])
}

model Project {
  id                 String               @id
  name               String
  description        String?
  status             String               @default("ACTIVE")
  priority           String               @default("MEDIUM")
  clientName         String?
  clientId           String?
  color              String?
  deadline           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  AiChat             AiChat[]
  AiProtocol         AiProtocol[]
  ChatDeleteRequest  ChatDeleteRequest[]
  ClientNotification ClientNotification[]
  Invitation         Invitation[]
  Client             Client?              @relation(fields: [clientId], references: [id])
  ProjectDocument    ProjectDocument[]
  ProjectMember      ProjectMember[]
  ProjectTodo        ProjectTodo[]
}

model UserSession {
  id        String   @id
  userId    String
  lastSeen  DateTime @default(now())
  ipAddress String?
  userAgent String?

  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeen])
}

model ProjectDocument {
  id        String   @id
  projectId String
  docType   String
  title     String
  content   String
  pdfData   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, docType])
}

model ProjectMember {
  id         String    @id
  projectId  String
  userId     String
  role       String    @default("MEMBER")
  joinedAt   DateTime  @default(now())
  assignedBy String?
  removedAt  DateTime?
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectTodo {
  id          String    @id
  projectId   String
  assigneeId  String?
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  Project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Assignee User?    @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  Creator  User     @relation("TodoCreator", fields: [createdBy], references: [id])
  Reviewer User?    @relation("TodoReviewer", fields: [reviewedBy], references: [id])

  @@index([projectId, sortOrder])
  @@index([assigneeId])
  @@index([projectId, status])
}

model ZaiChatMessage {
  id        String   @id
  projectId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model User {
  id                 String              @id
  name               String
  email              String              @unique
  password           String
  role               String              @default("MEMBER")
  avatar             String?
  isActive           Boolean             @default(true)
  jobTitle           String?
  phone              String?
  skills             String?
  status             String              @default("ACTIVE")
  mustChangePassword Boolean             @default(false)
  deletedAt          DateTime?
  joinDate           DateTime?
  lastLoginAt        DateTime?
  lastActivityAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  ActivityLog        ActivityLog[]
  AiChat             AiChat[]
  ChatDeleteRequest  ChatDeleteRequest[]
  Notification       Notification[]
  ProjectMember      ProjectMember[]
  ProjectTodo        ProjectTodo[]  @relation("TodoCreator")
  ProjectTodoAssign  ProjectTodo[]  @relation("TodoAssignee")
  ProjectTodoReview  ProjectTodo[]  @relation("TodoReviewer")
  UserSession        UserSession[]
}
